{
  "name": "sacredgrid-canvas2d",
  "version": "0.2.0",
  "description": "A Canvas2D implementation of Sacred Geometry patterns with interactive visualization",
  "author": "SacredGrid Contributors",
  "license": "MIT",
  "type": "module",
  "homepage": "https://sacred-grid.art",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/newjordan/Sacred-grid.art.git"
  },
  "bugs": {
    "url": "https://github.com/newjordan/Sacred-grid.art/issues"
  },
  "keywords": [
    "sacred-geometry",
    "canvas2d",
    "visualization",
    "geometry",
    "patterns",
    "react",
    "creative-coding"
  ],
  "dependencies": {
    "@react-spring/web": "^10.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.19.0",
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "gh-pages": "^6.3.0",
    "jsdom": "^31.0.1",
    "oxlint": "^1.95.0",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint src",
    "format": "prettier --write src/**/*.{js,jsx,ts,tsx,css}",
    "typecheck": "tsc --noEmit",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "prepublishOnly": "npm run build"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  }
}
